# =============================================================================
# Bawsalat Al-Aqar - Environment Variables Specification (.env.example)
# =============================================================================

# --- Supabase Postgres, Auth & Storage (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- AI Model & LLM Gateway (Gemini Flash / Flash-Lite) ---
# Primary key for AI SDK Google Provider:
AI_GATEWAY_API_KEY=
# Fallback / alternate key:
GOOGLE_GENERATIVE_AI_API_KEY=
# Model targets (defaults to gemini-flash-lite-latest):
AI_EXTRACTION_MODEL=gemini-flash-lite-latest
AI_ANALYSIS_MODEL=gemini-flash-lite-latest

# --- Payments & Webhook Gateway ---
# Set to 'true' to enable local/testing mock payment flows:
ENABLE_MOCK_PAYMENTS=true
# Webhook signature secret for verifying inbound gateway callbacks:
PAYMENT_WEBHOOK_SECRET=
# Diagnostic flag: force mock payments to report failure:
MOCK_PAYMENT_FORCE_FAIL=false

# --- Test Runner Flags ---
# Set to 'true' to run live external AI API calls during vitest runs:
RUN_AI_TESTS=false
